{
  "name": "libdb.so",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "make"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "printWidth": 100,
    "overrides": [
      {
        "files": "*.jsonld",
        "options": {
          "parser": "json"
        }
      },
      {
        "files": "*.svelte",
        "options": {
          "printWidth": 100
        }
      }
    ]
  },
  "devDependencies": {
    "@material-design-icons/svg": "^0.14.13",
    "@sveltejs/vite-plugin-svelte": "^2.4.6",
    "@tsconfig/svelte": "^5.0.2",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/jsonld": "^1.5.14",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.8.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "env": "^0.0.2",
    "fontfaceobserver": "^2.3.0",
    "libwebring": "github:diamondburned/libwebring#nightly",
    "normalize.css": "^8.0.1",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": " ^3.1.2",
    "sass": "^1.69.5",
    "super-tiny-icons": "^0.5.0",
    "svelte": " ^4.2.8",
    "svelte-check": " ^3.6.2",
    "svelte-language-server": "^0.15.22",
    "svelte-persisted-store": "^0.7.0",
    "svelte-preprocess": "^5.0.1",
    "typescript": "^5.3.3",
    "typescript-language-server": "^3.3.2",
    "vite": "^4.1.1",
    "vite-plugin-compression": "^0.5.1"
  },
  "imports": {
    "#/libdb.so/*": "./*"
  },
  "dependencies": {
    "jsonld": "^8.3.2",
    "tsx": "^4.11.2"
  }
}
