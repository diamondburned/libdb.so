---
import "@styles/document.css";

import { Font } from "astro:assets";
import SelfASCII from "@lib/components/SelfASCII.astro";
import Spiral from "@lib/components/Spiral.svelte";
import Footer from "@lib/components/Footer.astro";

const { frontmatter } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<Font cssVariable="--font-inconsolata" preload />
<title>{frontmatter.title ? `${frontmatter.title} - libdb.so` : "libdb.so"}</title>
<script is:inline src="@scripts/index.ts" type="module" defer></script>

<header id="header" class="self-ascii-container" style="height: 18em">
  <SelfASCII />
  <div id="spiral" class="spiral-container">
    <Spiral client:only="svelte" width={52} height={18} spinSpeed={2.0} blur={1.5} zoom={1.0} />
  </div>
  <button class="hidden control" id="a-stop">stop spiral</button>
  <button class="hidden control" id="a-show">reveal</button>
  <button class="hidden control" id="a-continue">continue to site</button>
</header>

<main id="content">
  <script is:inline>
    // Immediately begin animation by marking content as animated in JS before
    // more elements come in to prevent content blink. The inline part is
    // important, as it inserts this script tag as-is and halts rendering.
    document.getElementById("content").classList.add("animated");
    document.getElementById("header").dataset.expanded = "true";
  </script>

  <slot />
</main>

<Footer />

<style>
  #header {
    position: relative;
    scroll-margin-top: 1em; /* account for body margin */

    :global(.self-ascii) {
      overflow: hidden;
      position: absolute;

      width: 100%;
      height: inherit;
      margin: 0;
      filter: brightness(1.1);
      text-align: center;

      z-index: 2;

      :global(span:not([style="color:#000000"])) {
        background-color: var(--bg2-color);
      }
    }

    .spiral-container {
      position: absolute;
      color: var(--fg3-color);
    }

    .control {
      position: absolute;
      z-index: 99;
      background-color: var(--bg2-color);
    }

    #a-stop {
      display: block;
      bottom: 0;
      left: 0;
    }

    #a-show {
      display: block;
      bottom: 0;
      right: 0;
    }

    #a-continue {
      display: none;
      top: 52em;
      right: 0;
      width: 100%;
      text-align: center;
    }

    &[data-expanded] {
      :global(.self-ascii) {
        height: calc(100dvh - 1rem);
        background-color: var(--bg2-color);
      }

      .spiral-container {
        display: none;
      }

      #a-stop,
      #a-show {
        display: none;
      }

      #a-continue {
        display: block;
      }
    }
  }

  #spiral {
    animation: spiral-fade-in 4s ease-out;
  }

  @keyframes spiral-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  import { get } from "svelte/store";

  const content = document.getElementById("content")!;
  const contentGroups = groupElements([...content.children]);

  const spiral = document.getElementById("spiral")!;

  const header = document.getElementById("header")! as HTMLElement;
  header.querySelectorAll(".controls.hidden").forEach((el) => el.classList.remove("hidden"));

  const stopSpiralButton = document.getElementById("a-stop")!;
  stopSpiralButton.addEventListener("click", () => {
    const wasAnimating = get(window.animate);
    window.animate.set(!wasAnimating);
  });

  const showButton = document.getElementById("a-show")!;
  showButton.addEventListener("click", () => {
    header.dataset.expanded = "true";
  });

  let animated = false;

  const continueButton = document.getElementById("a-continue")!;
  continueButton.addEventListener("click", () => {
    animateContinue(!animated);
  });

  [stopSpiralButton, showButton, continueButton].forEach((btn) => {
    btn.classList.remove("hidden");
  });

  for (const group of contentGroups) {
    group.forEach((child) => setVisible(child, false));
  }

  async function animateContinue(animate = true) {
    delete header.dataset.expanded;

    if (!animate) {
      for (const group of contentGroups) {
        group.forEach((child) => setVisible(child, true));
      }
      return;
    }

    spiral.style.setProperty("display", "none");
    setVisible(stopSpiralButton, false);

    for (const group of contentGroups) {
      group.forEach((child) => setVisible(child, false));
    }

    // Animate the first 3 groups.
    for (let i = 0; i < 3; i++) {
      const group = contentGroups[i];

      setVisible(group[0], true);
      await sleep(250);

      group.slice(1).forEach((child) => setVisible(child, true));
      await sleep(250);
    }

    // Show the rest to hurry the animation.
    for (const group of contentGroups.slice(3)) {
      group.forEach((child) => setVisible(child, true));
    }

    const footer = document.getElementById("footer")! as HTMLElement;
    setVisible(footer, true);

    spiral.style.setProperty("display", "block");
    setVisible(stopSpiralButton, true);
  }

  function setVisible(element: HTMLElement, visible: boolean): void {
    element.style.setProperty("visibility", visible ? "visible" : "hidden");
  }

  function groupElements(children: Element[]): HTMLElement[][] {
    const groups = [];
    for (const child of children) {
      if (child instanceof HTMLElement === false) {
        continue;
      }
      if (!groups.length || ["h1", "h2"].some((sel) => child.matches(sel))) {
        groups.push([child]);
      } else {
        groups[groups.length - 1].push(child);
      }
    }
    return groups;
  }

  async function sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }
</script>
