---
import "@styles/document.css";

import { Font } from "astro:assets";
import SelfASCII from "@lib/components/SelfASCII.astro";

const { frontmatter } = Astro.props;
const version = import.meta.env.PUBLIC_SITE_VERSION?.trim().slice(0, 7);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<Font cssVariable="--font-inconsolata" preload />
<title>{frontmatter.title ? `${frontmatter.title} - libdb.so` : "libdb.so"}</title>
<script is:inline src="@scripts/index.ts" type="module" defer></script>

<aside id="self" class="self-ascii-container" style="height: 34ch">
  <SelfASCII />
  <button class="hidden" id="a-show">show</button>
  <button class="hidden" id="a-hide">hide</button>
</aside>

<main id="content">
  <script is:inline>
    // Immediately begin animation by marking content as animated in JS before
    // more elements come in to prevent content blink. The inline part is
    // important, as it inserts this script tag as-is and halts rendering.
    document.getElementById("content").classList.add("animated");
    document.getElementById("self").dataset.expanded = "true";
  </script>

  <slot />

  <footer id="footer">
    <p>
      [&lt;3] site running rev {
        version && version != "unknown" ? (
          <a class="version" href={`https://github.com/diamondburned/libdb/commit/${version}`}>
            {version}
          </a>
        ) : (
          "unknown"
        )
      }
    </p>
  </footer>
</main>

<style>
  .self-ascii-container {
    position: relative;
    scroll-margin-top: 1em; /* account for body margin */

    :global(.self-ascii) {
      overflow: hidden;
      position: absolute;

      width: 100%;
      height: inherit;
      text-align: center;
      line-height: 1;

      margin: 0;
      padding: 2ch;
      background-color: var(--bg2-color);
    }

    #a-show {
      display: block;

      position: absolute;
      bottom: 0;
      right: 0;
      z-index: 99;
    }

    #a-hide {
      display: none;

      position: absolute;
      top: 52em;
      right: 0;
    }

    &[data-expanded] {
      :global(.self-ascii) {
        height: calc(100dvh - 1rem);
      }

      #a-show {
        display: none;
      }

      #a-hide {
        display: block;
      }
    }
  }

  #content.animated > :global(*):not(:first-child) {
    opacity: 0;
  }
</style>

<script>
  async function animate() {
    const content = document.getElementById("content")!;
    const contentGroups = groupElements([...content.children]);

    for (const group of contentGroups) {
      group.forEach((child) => child.style.setProperty("opacity", "0"));
    }

    const ascii = document.getElementById("self")! as HTMLElement;

    ascii.querySelectorAll("button").forEach((btn) => {
      btn.classList.remove("hidden");
      btn.addEventListener("click", () => {
        if (ascii.dataset.expanded) {
          delete ascii.dataset.expanded;
        } else {
          ascii.dataset.expanded = "true";
        }
      });
    });

    ascii.dataset.expanded = "true";
    await sleep(1000);
    delete ascii.dataset.expanded;

    for (const group of contentGroups) {
      group[0].style.setProperty("opacity", "1");
      await sleep(250);

      group.slice(1).forEach((child) => child.style.setProperty("opacity", "1"));
      await sleep(250);
    }

    const footer = document.getElementById("footer")! as HTMLElement;
    footer.style.setProperty("opacity", "1");
  }

  function groupElements(children: Element[]): HTMLElement[][] {
    const groups = [];
    for (const child of children) {
      if (child instanceof HTMLElement === false) {
        continue;
      }
      if (!groups.length || ["h1", "h2"].some((sel) => child.matches(sel))) {
        groups.push([child]);
      } else {
        groups[groups.length - 1].push(child);
      }
    }
    return groups;
  }

  async function sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  animate();
</script>
