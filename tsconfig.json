{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "site/env.d.ts", "**/*"],
  "exclude": ["dist", "jsonld"],
  "compilerOptions": {
    "paths": {
      "@lib/*": ["./site/lib/*"],
      "@pages/*": ["./site/pages/*"],
      "@styles/*": ["./site/styles/*"],
      "@scripts/*": ["./site/scripts/*"],
      "@layouts/*": ["./site/layouts/*"],
      "@dist/*": ["./dist/*"]
    },
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  }
}
